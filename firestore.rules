rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════
    //  FUNÇÕES DE AUXÍLIO (HELPERS) OTIMIZADAS
    // ═══════════════════════════════════════════════════════════

    function logado() {
      return request.auth != null;
    }

    function eDono(uid) {
      return logado() && request.auth.uid == uid;
    }

    // 🔥 LEITURA IMEDIATA: Não gasta leitura no banco!
    function eCoordenador() {
      return logado() && request.auth.token.role == "coordenador";
    }
    
    function eAdminGeral() {
      return logado() && request.auth.token.role == "admin"; // ou continua via DB se preferir
    }

    function mantendoRole() {
      return !("role" in request.resource.data) || request.resource.data.role == resource.data.role;
    }

    function perfilProfessorValido() {
      return request.resource.data.role == "professor";
    }

    // ═══════════════════════════════════════════════════════════
    //  REGRAS POR COLEÇÃO
    // ═══════════════════════════════════════════════════════════

    match /admins/{adminId} {
      allow read: if logado();
      allow write: if false; 
    }

    match /escolas/{escolaId} {
      allow create: if true; 
      allow read: if logado(); 
      allow update, delete: if eAdminGeral(); 
    }

    match /users/{uid} {
      allow get: if logado() && (eDono(uid) || eCoordenador());
      allow list: if logado();
      allow create: if (eDono(uid) && perfilProfessorValido()) || (eCoordenador() && perfilProfessorValido());
      allow update: if (eDono(uid) && mantendoRole()) || eCoordenador();
      allow delete: if false;
    }

    match /users/{uid}/notificacoes/{notifId} {
      allow read, update, delete: if eDono(uid);
      allow create: if logado();
    }

    match /turmas/{uid}/{document=**} {
      allow read: if logado() && (eDono(uid) || eCoordenador() || resource.data.professorId == request.auth.uid);
      allow write: if logado() && (eDono(uid) || eCoordenador());
    }

    // 🔥 A MÁGICA ACONTECE AQUI: Registros sem `get()`
    match /turmas/{uid}/lista/{turmaId}/registros/{registroId} {
      allow read, write: if logado() && (
        eDono(uid) || 
        eCoordenador() || 
        resource.data.ownerUid == request.auth.uid || 
        request.resource.data.ownerUid == request.auth.uid
      );
    }

    // 🔥 Presença sem `get()`
    match /turmas/{uid}/lista/{turmaId}/presencas/{presencaId} {
       allow read, write: if logado() && (
        eDono(uid) || 
        eCoordenador() || 
        resource.data.ownerUid == request.auth.uid || 
        request.resource.data.ownerUid == request.auth.uid
      );
    }

    // 🔥 Notas sem `get()`
    match /turmas/{uid}/lista/{turmaId}/notas/{notaId} {
       allow read, write: if logado() && (
        eDono(uid) || 
        eCoordenador() || 
        resource.data.ownerUid == request.auth.uid || 
        request.resource.data.ownerUid == request.auth.uid
      );
    }

    match /turmas/{uid}/lista/{turmaId}/alunos/{alunoId} {
      allow read: if logado();
      allow write: if logado() && (eDono(uid) || eCoordenador());
    }

    match /cronogramas/{uid}/{document=**} {
      allow read, write: if logado() && (eDono(uid) || eCoordenador());
    }
    
    match /cronogramas_escola/{cronogramaId} {
      allow read: if logado();
      allow write: if eCoordenador();

      match /aulas/{aulaId} {
        allow read: if logado();
        allow write: if eCoordenador();
      }
    }

    match /professores_escola/{docId} {
      allow read: if logado();
      allow write: if eCoordenador();
    }
    
    match /arquivos/{uid}/{document=**} {
      allow read: if logado() && (eDono(uid) || eCoordenador());
      allow write: if logado() && eDono(uid);
    }

    match /calendario/{uid}/{document=**} {
      allow read, write: if logado() && (eDono(uid) || eCoordenador());
    }

    match /eventos_escola/{eventoId} {
      allow read: if logado();
      allow create, update, delete: if eCoordenador();
    }

    match /turmas_periodo/{docId} {
      allow read: if logado();
      allow create, update, delete: if eCoordenador();
    }
    
    match /{path=**}/lista/{turmaId} {
      allow read: if logado();
    }

    match /solicitacoes_arquivos/{docId} {
      allow read, create: if logado();
      allow update, delete: if eCoordenador();
    }

    match /turmas_arquivos_aprovados/{docId} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.enviadoPorUid == request.auth.uid;
      allow update: if eCoordenador();
      allow delete: if eCoordenador() || (logado() && resource.data.enviadoPorUid == request.auth.uid);
    }

    match /configuracoes_escola/{docId} {
      allow read: if logado();
      allow create, update, delete: if eCoordenador();
    }
    
    match /salas/{escolaId}/lista/{nomeSala}/alunos/{alunoId} {
      allow read: if logado();
      allow write: if eCoordenador();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}